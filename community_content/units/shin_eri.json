  "localization": {
    "EN": {
      "name": "SHIN ERI",
      "description": "STAND. ATK : Laser     SPEC. ATK : Laser (Big)\nA staff sergeant in the military intelligence special forces. \nA.K.A. Memphis Bomb Princess. Has a laser with maximum range."
    },
    "JP": {
      "name": "真 エリ",
      "description": "通常攻撃：レーザーガン     特殊攻撃：レーザーガン（大）\n正規軍情報特殊部隊の二等軍曹。メンフィスの爆弾娘の異名を持つ。\n最大射程を誇るレーザーガンを所持。"
    },
    "KR": {
      "name": "진 에리",
      "description": "일반 공격: 레이저     특수 공격: 레이저 (대)\n군 정보 특수 부대의 이등 중사. \n멤피스의 폭탄 공주로 불린다. 최대 사거리를 자랑하는 레이저 총을 소지."
    },
    "ES": {
      "name": "SHIN ERI",
      "description": "ATQ ESTÁND. : Láser     ATQ ESPEC. : Láser (grande)\nSargento en las fuerzas especiales de inteligencia militar. \nApodado Princesa Memphis Bomb. Tiene un láser de máximo alcance."
    },
    "PT": {
      "name": "SHIN ERI",
      "description": "ATQ. PADR. : Laser   ATQ. ESPEC. : Laser (grande)\nPrimeira-sargento nas forças especiais da inteligência militar. A\n\"Princesa Bombardeira de Memphis\"  tem um laser com alcance máximo."
    },
    "FR": {
      "name": "SHIN ERI",
      "description": "ATT. STAND : Laser   ATT. SPÉ : Laser (grand)\nSergent-chef des forces spéciales de renseignement militaire. Alias\nla Princesse des Bombes de Memphis. A un laser à grande portée."
    },
    "DE": {
      "name": "SHIN ERI",
      "description": "STAND. ATK : Laser     SPEC. ATK : Laser (Big)\nA staff sergeant in the military intelligence special forces. \nA.K.A. Memphis Bomb Princess. Has a laser with maximum range."
    },
    "IT": {
      "name": "SHIN ERI",
      "description": "ATC STAND.: Laser   ATC SPEC.: Laser (grande)\nUn sergente maggiore nelle forze speciali dell'intelligence. \nAlias Memphis Bomb Princess. Ha un laser con la portata massima."
    },
    "ZS": {
      "name": "真 英里",
      "description": "普通攻击：激光枪     特殊攻击：激光枪（大）\n正规军情报特殊部队的下士。拥有「孟菲斯炸弹女」的绰号。\n拥有最大射程极佳的激光枪。"
    },
    "ZT": {
      "name": "真 英里",
      "description": "普通攻擊：雷射槍     特殊攻擊：雷射槍（大）\n正規軍情報特殊部隊的下士。擁有「孟菲斯炸彈女」的綽號。\n擁有最大射程極佳的雷射槍。"
    },
    "RU": {
      "name": "СИН ЭРИ",
      "description": "СТАНД. АТАК: Лазер   СПЕЦ. АТАК: Лазер (большой)\nСержант в составе спецвойск военной интеллигенции.  \nПринцесса Бомба Мемфиса. Лазер с макс. диапазоном."
    }
