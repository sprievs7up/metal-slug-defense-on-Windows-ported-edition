  "localization": {
    "EN": {
      "name": "SHIN FIO",
      "description": "STAND. ATK : Rocket Launcher     SPEC. ATK : Rocket Launcher (Big)\nA sergeant major in the military intelligence special forces. Quiet\nbut a bit of an airhead. Has a high-powered rocket launcher."
    },
    "JP": {
      "name": "真 フィオ",
      "description": "通常攻撃：ロケットランチャー     特殊攻撃：ロケットランチャー（大）\n正規軍情報特殊部隊の上級曹長。おっとりした性格でやや天然。\n高火力なロケットランチャーを所持。"
    },
    "KR": {
      "name": "진 피오",
      "description": "일반 공격: 로켓 발사기     특수 공격: 로켓 발사기 (대)\n군 정보 특수 부대의 상급 상사.\n차분하지만 약간 모자란 면이 있다. 고화력 로켓 발사기를 소지."
    },
    "ES": {
      "name": "SHIN FIO",
      "description": "ATQ ESTÁND. : Lanzacohetes     ATQ ESPEC. : Lanzacohetes (grande)\nComandante Sargento en las fuerzas especiales. Silencioso pero \nun tanto distraído. Tiene un lanzacohetes de alta potencia."
    },
    "PT": {
      "name": "SHIN FIO",
      "description": "ATQ. PADR. : Lança-Mísseis   ATQ. ESPEC. : Lança-Mísseis (grande)\nUma sargento-mor nas forças especiais da inteligência militar. Quieta,\nmas um tanto distraída. Possui um lança-mísseis altamente poderoso."
    },
    "FR": {
      "name": "SHIN FIO",
      "description": "ATT. STAND : Lance-roquette   ATT. SPÉ : Lance-roquette (grand)\nSergent-major des forces spéciales de renseignement militaire.\nCalme mais un peu crétin. A un lance-roquette puissant."
    },
    "DE": {
      "name": "SHIN FIO",
      "description": "STAND. ATK : Rocket Launcher     SPEC. ATK : Rocket Launcher (Big)\nA sergeant major in the military intelligence special forces. Quiet\nbut a bit of an airhead. Has a high-powered rocket launcher."
    },
    "IT": {
      "name": "SHIN FIO",
      "description": "ATC STAND.: Lanciarazzi   ATC SPEC.: Lanciarazzi (grande)\nUn sergente maggiore nelle forze speciali dell'intelligence militare. \nTranquillo ma un po' tra le nuvole. Ha un potente lanciarazzi."
    },
    "ZS": {
      "name": "真 菲欧",
      "description": "普通攻击：火箭炮     特殊攻击：火箭炮（大）\n正规军情报特殊部队的军士长。性格稳重，但有点天然呆\n拥有火力强大的火箭炮。"
    },
    "ZT": {
      "name": "真 菲歐",
      "description": "普通攻擊：火箭砲     特殊攻擊：火箭砲（大）\n正規軍情報特殊部隊的軍士長。性格穩重，但有點天然呆\n擁有火力強大的火箭砲。"
    },
    "RU": {
      "name": "СИН ФИО",
      "description": "СТАНД. АТАК: Ракетопускатель   СПЕЦ. АТАК: Ракетопускатель (большой)\nСержант-майор в спецвойсках военной интеллигенции. Спокойный,\nно слегка пустоголовый. Высокомощный ракетопускатель."
    }
  },
