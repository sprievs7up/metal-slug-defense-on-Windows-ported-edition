  "localization": {
    "EN": {
      "name": "MOLE MISSILE",
      "description": "STAND. ATK : Self-Destruct     SPEC. ATK : Massive Self-Destruct\nA drilling missile developed by the future Rebel Army.\nIt silently advances to the front line, then explodes."
    },
    "JP": {
      "name": "モグラ弾",
      "description": "通常攻撃：自爆     特殊攻撃：自爆・大\n未来のモーデン軍が開発した掘削ミサイル。\n音もなく前線まで進み、爆発する。"
    },
    "KR": {
      "name": "모구라탄",
      "description": "일반 공격: 자폭     특수 공격: 대규모 자폭\n미래의 모덴군이 개발한 굴착 미사일.\n소리 없이 전선까지 나아가 폭발한다."
    },
    "ES": {
      "name": "MISIL TOPO",
      "description": "ATQ ESTÁND. : Autodestruc.     ATQ ESPEC. : Autodestruc. masiva\nMisil perforador desarrollado por el Ejército Rebelde del futuro.\nAvanza sigilosamente hasta el frente y explota."
    },
    "PT": {
      "name": "MÍSSIL TOUPEIRA",
      "description": "ATQ. PADR. : Autodestruição   ATQ. ESPEC. : Autodestruição Massiva\nMíssil perfurador desenvolvido pelo Exército Rebelde do futuro.\nAvança silenciosamente até a linha de frente e explode."
    },
    "RU": {
      "name": "РАКЕТА-КРОТ",
      "description": "СТАНД. АТАК: Самоликв. СПЕЦ. АТАК: Массивн. Самоликв.\nБуровая ракета, созданная армией повстанцев будущего.\nБесшумно продвигается к линии фронта и взрывается."
    },
    "FR": {
      "name": "MISSILE TAUPE",
      "description": "ATT. STAND : Autodestruction   ATT. SPÉ : Autodestruction massive\nMissile foreur développé par l'armée rebelle du futur.\nIl avance en silence jusqu'à la ligne de front, puis explose."
    },
    "DE": {
      "name": "MAULWURFSRAKETE",
      "description": "NORM. ANGR.: Explosion SPEZ. ANGR.: Große Explosion\nBohrrakete, entwickelt von der Rebellenarmee der Zukunft.\nRückt lautlos bis zur Front vor und explodiert."
    },
    "IT": {
      "name": "MISSILE TALPA",
      "description": "ATC STAND.: Autodistruzione   ATC SPEC.: Potente Autodistruzione\nMissile perforante sviluppato dall'esercito ribelle del futuro.\nAvanza silenziosamente fino al fronte, poi esplode."
    },
    "ZT": {
      "name": "鼴鼠彈",
      "description": "普通攻擊：自爆     特殊攻擊：自爆（大）\n未來叛軍研製的鑽地飛彈。\n悄無聲息地前進至前線然後爆炸。"
    },
    "ZS": {
      "name": "鼹鼠弹",
      "description": "普通攻击：自爆     特殊攻击：自爆（大）\n未来叛军研制的钻地飞弹。\n悄无声息地前进至前线然后爆炸。"
    }
  },
