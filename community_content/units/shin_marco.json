  "localization": {
    "EN": {
      "name": "SHIN MARCO",
      "description": "STAND. ATK : Heavy Machine Gun     SPEC. ATK : Heavy Machine Gun (Big)\nA major in the military. Excels at programming soldiers \nin training. Has an easy-to-use heavy machine gun."
    },
    "JP": {
      "name": "真 マルコ",
      "description": "通常攻撃：ヘビーマシンガン     特殊攻撃：ヘビーマシンガン（大）\n正規軍少佐。叩き上げの軍人でプログラミングに秀でる。\n使いやすいヘビーマシンガンを所持。"
    },
    "KR": {
      "name": "진 마르코",
      "description": "일반 공격: 헤비 머신건     특수 공격: 헤비 머신건 (대)\n군 소령. 군인 훈련에 탁월. 사용하기 쉬운 헤비 머신건을 소지."
    },
    "ES": {
      "name": "SHIN MARCO",
      "description": "ATQ ESTÁND. : Ametralladora pesada     ATQ ESPEC. : Ametralladora pesada (grande)\nUn comandante en el ejército. Destaca en el entrenamiento a\nsoldados. Tiene una ametralladora pesada fácil de usar."
    },
    "PT": {
      "name": "SHIN MARCO",
      "description": "ATQ. PADR. : Metralhadora Pesada   ATQ. ESPEC. : Metralhadora Pesada (grande)\nUm major no exército. É excelente para coordenar soldados \nem treinamento. Possui uma metralhadora pesada fácil de usar."
    },
    "FR": {
      "name": "SHIN MARCO",
      "description": "ATT. STAND : Mitraillette lourde   ATT. SPÉ : Mitraillette lourde (grand)\nUn major dans l'armée. Excelle dans l'art de programmer les soldats\npour l'entraînement. A une mitraillette facile à prendre en main."
    },
    "DE": {
      "name": "SHIN MARCO",
      "description": "STAND. ATK : Heavy Machine Gun     SPEC. ATK : Heavy Machine Gun (Big)\nA major in the military. Excels at programming soldiers \nin training. Has an easy-to-use heavy machine gun."
    },
    "IT": {
      "name": "SHIN MARCO",
      "description": "ATC STAND.: Mitragliatrice Pesante ATC SPEC.: Mitragliatrice Pesante (grande)\nUn maggiore nell'esercito. Eccelle nell'insegnamento ai soldati \nnell'addestramento. Ha una pesante mitragliatrice, facile da usare."
    },
    "ZS": {
      "name": "真 马可",
      "description": "普通攻击：重机枪     特殊攻击：重机枪（大）\n正规军少校。经过千锤百炼的军人，擅长写程序。\n持有相当好用的重机枪。"
    },
    "ZT": {
      "name": "真 馬可",
      "description": "普通攻擊：重機槍     特殊攻擊：重機槍（大）\n正規軍少校。經過千錘百鍊的軍人，擅長寫程式。\n持有相當好用的重機槍。"
    },
    "RU": {
      "name": "СИН МАРКО",
      "description": "СТАНД. АТАК: Тяжёлый Пулемёт   СПЕЦ. АТАК: Тяжёлый Пулемёт (большой)\nГлавный в вооружённых силах. Превосходно программирует солдат \nна тренировке. У него есть простой в обращении пулемёт."
    }
  },
