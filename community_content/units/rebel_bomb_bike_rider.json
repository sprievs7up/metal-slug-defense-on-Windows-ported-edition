  "localization": {
    "EN": {
      "name": "RIDER SOLDIER",
      "description": "STAND. ATK : Bike Throw     SPEC. ATK : Bike Throw\nA fanatic soldier of the Rebel Army bike squad.\nHurls the bike for a deadly blow, and fights on even after that."
    },
    "JP": {
      "name": "バイク兵",
      "description": "通常攻撃：バイク投げ     特殊攻撃：バイク投げ\nモーデン軍バイク部隊の狂信的な兵士。\nバイクを投げて必殺の一撃を放ち、投げた後も戦い続ける。"
    },
    "KR": {
      "name": "바이크병",
      "description": "일반 공격: 바이크 던지기     특수 공격: 바이크 던지기\n모덴군 바이크 부대의 광신적인 병사.\n바이크를 던져 치명적인 일격을 가하고, 던진 뒤에도 계속 싸운다."
    },
    "ES": {
      "name": "SOLDADO RIDER",
      "description": "ATQ ESTÁND. : Lanzar moto     ATQ ESPEC. : Lanzar moto\nSoldado fanático del escuadrón de motos rebelde.\nLanza la moto como golpe letal y sigue luchando después."
    },
    "PT": {
      "name": "SOLDADO MOTOQUEIRO",
      "description": "ATQ. PADR. : Arremesso de moto   ATQ. ESPEC. : Arremesso de moto\nSoldado fanático do esquadrão de motos rebelde.\nArremessa a moto num golpe fatal e continua lutando depois."
    },
    "RU": {
      "name": "СОЛДАТ-ВСАДНИК",
      "description": "СТАНД. АТАК: Бросок мотоцикла СПЕЦ. АТАК: Бросок мотоцикла\nФанатичный солдат мотоотряда повстанцев.\nБросает мотоцикл как смертельный удар и продолжает бой."
    },
    "FR": {
      "name": "SOLDAT MOTARD",
      "description": "ATT. STAND : Lancer de moto   ATT. SPÉ : Lancer de moto\nSoldat fanatique de l'escadron motorisé rebelle.\nIl projette sa moto pour un coup fatal et continue de combattre."
    },
    "DE": {
      "name": "MOTORRADSOLDAT",
      "description": "NORM. ANGR.: Motorradwurf SPEZ. ANGR.: Motorradwurf\nFanatischer Soldat der Motorradstaffel der Rebellen.\nSchleudert das Motorrad als tödlichen Schlag und kämpft danach weiter."
    },
    "IT": {
      "name": "SOLDATO MOTOCICLISTA",
      "description": "ATC STAND.: Lancio moto   ATC SPEC.: Lancio moto\nSoldato fanatico della squadra motociclisti ribelle.\nScaglia la moto come colpo letale e continua a combattere."
    },
    "ZT": {
      "name": "機動兵",
      "description": "普通攻擊：拋擲機車     特殊攻擊：拋擲機車\n叛軍機車部隊的狂熱士兵。拋出機車使出致命一擊。\n哪怕拋出機車也會繼續作戰"
    },
    "ZS": {
      "name": "机动兵",
      "description": "普通攻击：抛掷机车     特殊攻击：抛掷机车\n叛军机车部队的狂热士兵。抛出机车使出致命一击。\n哪怕抛出机车也会继续作战"
    }
  },
